# PREDICTOR (VisionClassify) Environment Variables
DJANGO_SECRET_KEY=replace-with-a-secure-50-char-production-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional PostgreSQL Database URL (Leave blank in development to use SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/visionclassify

# Upload limit in MB
MAX_UPLOAD_SIZE_MB=10
